# AI Revenue Recovery System Configuration

# Environment mode: sandbox | staging | production (MVP locked to sandbox)
ENVIRONMENT=sandbox

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=

# Security & Authorization
AUTH_SIGNING_SECRET=change-this-insecure-key-for-dev-only
TOKEN_EXPIRY_SECONDS=300

# Sandbox Payment / Messaging Simulator
SANDBOX_PAYMENT_SIMULATOR_URL=http://localhost:8001
SANDBOX_MESSAGING_SIMULATOR_URL=http://localhost:8002

# Observability & Audit
LOG_LEVEL=INFO
AUDIT_STORAGE_PATH=./logs/audit.log
